{
  "$schema": "https://json.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=1024 node_modules/.bin/vite build",
    "format": "prettier --write 'resources/**/*.{blade.php,js,css,json}'",
    "format:check": "prettier --check 'resources/**/*.{blade.php,js,css,json}'",
    "lint:php": "./vendor/bin/pint",
    "lint:php:check": "./vendor/bin/pint --test",
    "lint:js": "eslint resources/js/ --fix",
    "lint:js:check": "eslint resources/js/",
    "analyse": "./vendor/bin/phpstan analyse",
    "test": "php artisan test --exclude-group=browser",
    "test:e2e": "npm run build && ./vendor/bin/pest --group=browser",
    "quality": "npm run lint:php:check && npm run format:check && npm run analyse && npm run test",
    "lint:last-commit-msg": "git log -1 --pretty=%B | npx --no-install commitlint",
    "commit": "git-cz",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.php": [
      "./vendor/bin/pint --dirty"
    ],
    "*.blade.php": [
      "prettier --write"
    ],
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/cz-commitlint": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "axios": "^1.11.0",
    "commitizen": "^4.3.1",
    "concurrently": "^9.0.1",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "glob": "^11.0.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "laravel-vite-plugin": "^2.0.0",
    "lint-staged": "^16.4.0",
    "path": "^0.12.7",
    "playwright": "^1.60.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-blade": "^3.1.4",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^4.1.18",
    "vite": "^7.2.7"
  },
  "name": "laravel-admin-inspinia",
  "version": "0.1.0",
  "description": "Frontend do boilerplate admin Laravel (Livewire 4 + Inspinia + Tailwind 4).",
  "dependencies": {
    "@iconify/json": "^2.2.384",
    "@iconify/tailwind4": "^1.0.6",
    "@simonwep/pickr": "^1.9.1",
    "@sjmc11/tourguidejs": "^0.0.27",
    "animate.css": "^4.1.1",
    "apexcharts": "^5.3.5",
    "chart.js": "^4.5.1",
    "choices.js": "^11.1.0",
    "clipboard": "^2.0.11",
    "cropperjs": "^1.6.2",
    "daterangepicker": "^3.1.0",
    "dayjs": "^1.11.19",
    "diff": "^8.0.3",
    "dropzone": "^6.0.0-beta.2",
    "echarts": "^6.0.0",
    "filepond": "^4.32.8",
    "filepond-plugin-file-encode": "^2.1.14",
    "filepond-plugin-file-validate-size": "^2.2.8",
    "filepond-plugin-image-exif-orientation": "^1.0.11",
    "filepond-plugin-image-preview": "^4.6.12",
    "flatpickr": "^4.6.13",
    "fullcalendar": "^6.1.19",
    "glightbox": "^3.3.1",
    "inputmask": "^5.0.9",
    "isomorphic-dompurify": "^3.10.0",
    "jstree": "^3.3.17",
    "jsvectormap": "^1.7.0",
    "ladda": "1.0.6",
    "leaflet": "^1.9.4",
    "lucide": "^1.11.0",
    "masonry-layout": "^4.2.2",
    "moment": "^2.30.1",
    "muuri": "^0.9.5",
    "nouislider": "^15.8.1",
    "pdfjs-dist": "2.16.105",
    "plyr": "^3.8.4",
    "preline": "4.0.1",
    "prismjs": "^1.30.0",
    "quill": "^2.0.3",
    "select2": "^4.1.0-rc.0",
    "simplebar": "^6.3.3",
    "sortablejs": "^1.15.6",
    "sweetalert2": "^11.22.5",
    "tinycon": "^0.6.8",
    "tinymce": "^8.4.0",
    "typeahead.js": "^0.11.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "^4.60.2"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}
