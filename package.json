{
  "$schema": "https://json.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=1024 node_modules/.bin/vite build",
    "format": "prettier --write 'resources/**/*.{blade.php,js,css,json}'",
    "format:check": "prettier --check 'resources/**/*.{blade.php,js,css,json}'",
    "lint:php": "./vendor/bin/pint",
    "lint:php:check": "./vendor/bin/pint --test",
    "lint:js": "eslint resources/js/ --fix",
    "lint:js:check": "eslint resources/js/",
    "analyse": "./vendor/bin/phpstan analyse",
    "test": "php artisan test --exclude-group=browser",
    "test:e2e": "npm run build && ./vendor/bin/pest --group=browser",
    "quality": "npm run lint:php:check && npm run lint:js:check && npm run format:check && npm run analyse && npm run test",
    "lint:last-commit-msg": "git log -1 --pretty=%B | npx --no-install commitlint",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.php": [
      "./vendor/bin/pint --dirty"
    ],
    "*.blade.php": [
      "prettier --write"
    ],
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.2",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "laravel-vite-plugin": "^3.1.3",
    "lint-staged": "^17.0.8",
    "playwright": "^1.61.1",
    "postcss": "^8.5.19",
    "prettier": "^3.9.5",
    "prettier-plugin-blade": "^3.2.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.1",
    "vite": "^8.1.4"
  },
  "name": "laravel-admin-inspinia",
  "version": "0.1.0",
  "description": "Frontend do boilerplate admin Laravel (Livewire 4 + Inspinia + Tailwind 4).",
  "dependencies": {
    "@iconify/json": "^2.2.500",
    "@iconify/tailwind4": "^1.2.3",
    "apexcharts": "^5.16.0",
    "choices.js": "^11.2.3",
    "cropperjs": "^1.6.2",
    "dropzone": "^6.0.0-beta.2",
    "flatpickr": "^4.6.13",
    "inputmask": "^5.0.9",
    "lucide": "^1.24.0",
    "moment": "^2.30.1",
    "preline": "4.2.0",
    "quill": "^2.0.3",
    "simplebar": "^6.3.3",
    "sortablejs": "^1.15.7",
    "sweetalert2": "^11.26.25"
  }
}
