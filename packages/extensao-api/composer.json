{
    "name": "ht2ml/extensao-api",
    "description": "Extensão API: envelope de resposta, paginação, idioma, erros e tokens Sanctum para APIs REST de produtos HT2ML.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "dedoc/scramble": "^0.13",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "laravel/sanctum": "^4.0",
        "symfony/http-foundation": "^8.0",
        "symfony/http-kernel": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "HT2ML\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HT2ML\\Api\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HT2ML\\Api\\ApiServiceProvider"
            ]
        },
        "ht2ml": {
            "tipo": "biblioteca"
        }
    },
    "minimum-stability": "stable"
}
