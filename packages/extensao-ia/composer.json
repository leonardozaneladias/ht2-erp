{
    "name": "ht2ml/extensao-ia",
    "description": "Extensão IA: contratos de tradução, resumo e assistente, fakes, cache de tradução e limites por custo para produtos HT2ML.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "HT2ML\\Ia\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HT2ML\\Ia\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HT2ML\\Ia\\IaServiceProvider"
            ]
        },
        "ht2ml": {
            "tipo": "biblioteca"
        }
    },
    "minimum-stability": "stable"
}
