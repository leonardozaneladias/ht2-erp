<?php

declare(strict_types=1);

namespace __PKG_NAMESPACE__;

use HT2ML\Core\Support\Modules\ModuleRegistry;
use Illuminate\Support\ServiceProvider;

/**
 * ServiceProvider da extensão __MODULO_STUDLY__.
 *
 * Integra o pacote ao core sem editar arquivos do boilerplate (ver ADR-0015):
 * - Rotas entram no grupo autenticado /admin via ModuleRegistry (herdam o middleware).
 * - Área, seção, grupos e recursos saem de config/__MODULO_SLUG__.php (publicável),
 *   lidos pelo ModuloBuilder. Permissões, itens de menu, nomes de rota e padrões
 *   de `active` são DERIVADOS da chave de cada recurso — não escritos à mão.
 */
final class __PROVIDER_CLASS__ extends ServiceProvider
{
    public function register(): void
    {
        $this->mergeConfigFrom(__DIR__ . '/../config/__MODULO_SLUG__.php', '__MODULO_SLUG__');

        // Seeders da extensão, se houver. Use antesDoCore: true quando os
        // seeders de demo do core dependerem destes dados (catálogos, por
        // exemplo); do contrário eles rodam depois, já com empresas e perfis
        // no lugar.
        // ModuleRegistry::seeder(\__PKG_NAMESPACE__\Database\Seeders\__MODULO_STUDLY__Seeder::class);

        // Declarado no register() por causa das ROTAS: o callback precisa
        // existir antes do carregamento de routes/admin.php, e o require roda
        // DENTRO do grupo admin do core — o módulo herda prefixo /admin, name
        // "admin." e todo o middleware. O resto do builder é preguiçoso: só é
        // aplicado em aplicarContribuicoes(), então a ordem aqui não importa.
        //
        // require, e não loadRoutesFrom(): o callback fica num registry estático
        // que sobrevive à troca de instância de app entre testes, e
        // loadRoutesFrom() lê $this->app — que, vindo de uma instância já
        // descartada, estoura "Target class [files] does not exist".
        ModuleRegistry::modulo('__MODULO_SLUG__')
            ->label('__MODULO_STUDLY__')
            ->deConfig('__MODULO_SLUG__')
            ->rotas(function (): void {
                $rotas = __DIR__ . '/../routes/admin.php';

                if (is_file($rotas)) {
                    require $rotas;
                }
            });
    }

    public function boot(): void
    {
        $this->loadViewsFrom(__DIR__ . '/../resources/views', '__MODULO_SLUG__');
        $this->loadMigrationsFrom(__DIR__ . '/../database/migrations');

        $this->publishes([
            __DIR__ . '/../config/__MODULO_SLUG__.php' => config_path('__MODULO_SLUG__.php'),
        ], '__MODULO_SLUG__-config');


        // make:recurso registra os componentes Livewire e as policies do recurso acima desta linha
    }


}
