# Conteúdo das pastas de framework é ignorado pelos .gitignore internos de cada
# diretório (padrão Laravel: `*` + `!.gitignore`), preservando a pasta vazia.
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/vendor
Homestead.json
Homestead.yaml
Thumbs.db

# Husky
/.husky/_

# Ferramentas de qualidade
.phpstan.cache
coverage/

# IDEs
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Claude Code (memórias e logs de sessão — dados locais do desenvolvedor)
.claude/

# Python bytecode (scripts de skills)
__pycache__/
*.pyc

# Visual companion
/.superpowers/

# Estado local de orquestração de workflows (tooling do desenvolvedor)
/.workflows/

# Playwright MCP (screenshots/snapshots de validação local)
/.playwright-mcp

# Testes de browser (Pest + Playwright)
/tests/Browser/Screenshots
.workflows/.cache/
