*.log
.DS_Store
.env
.env.backup
.env.bak
.env.production

# Backups locais do .env e de configs — o padrão `.env.bak` acima NÃO cobre os sufixados
# (`.env.bak-20260710-2336`, `.env.bak-ddev`), e um `git add -A` os arrastava para dentro
# do commit COM os segredos (APP_KEY, DB_PASSWORD).
.env.bak*
.env.*.bak
*.bak-*
*.backup-*
.phpactor.json
.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.zed
/auth.json
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
# Exports gerados pelo PowerGrid (storage_path) — artefatos, não versionar.
/storage/*.xlsx
/storage/*.csv
# Conteúdo das pastas de framework é ignorado pelos .gitignore internos de cada
# diretório (padrão Laravel: `*` + `!.gitignore`), preservando a pasta vazia.
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/vendor
Homestead.json
Homestead.yaml
Thumbs.db

# Husky
/.husky/_
# Opt-out local do bloqueio de push à main (instância de cliente; ver .husky/pre-push)
/.husky/allow-main-push

# DDEV — override local por instância de cliente (name do projeto / URL).
# Também coberto por .ddev/.gitignore; explícito aqui para descoberta.
/.ddev/config.local.yaml

# dev-stack — manifesto local do ambiente (slug, PHP, banco); varia por máquina.
/.dev-stack.json

# Ferramentas de qualidade
.phpstan.cache
coverage/

# IDEs
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Claude Code (memórias e logs de sessão — dados locais do desenvolvedor)
.claude/

# Python bytecode (scripts de skills)
__pycache__/
*.pyc

# Visual companion
/.superpowers/

# Estado local de orquestração de workflows (tooling do desenvolvedor)
/.workflows/

# Playwright MCP (screenshots/snapshots de validação local)
/.playwright-mcp

# Testes de browser (Pest + Playwright)
/tests/Browser/Screenshots
.workflows/.cache/

# Módulos-pacote: versionados no monorepo da base (core + packages/modulo-*).
# Cada pacote é extraído para seu repo próprio no release (git subtree split,
# ver bin/release-module.sh). Ver ADR-0015/ADR-0016 e docs/distribuicao-manutencao.md.
# O vendor/ e composer.lock de cada pacote ficam fora via packages/<modulo>/.gitignore.
