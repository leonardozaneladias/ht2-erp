#!/usr/bin/env sh
# 1) Ajusta escopos inválidos (ex.: database -> models) para passar no commitlint
# 2) Remove trailers Co-authored-by do Cursor
#
# Nota: o botão "Generate Commit Message" do Cursor não lê as Project Rules; este hook corrige o mínimo automaticamente.

COMMIT_MSG_FILE="$1"
[ -n "$COMMIT_MSG_FILE" ] && [ -r "$COMMIT_MSG_FILE" ] || exit 0

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

if command -v python3 >/dev/null 2>&1; then
  python3 "$REPO_ROOT/scripts/git/prepare-commit-msg-portalart.py" "$COMMIT_MSG_FILE" || exit 1
else
  TMP="${COMMIT_MSG_FILE}.portalart-final"
  awk '
    /^Co-authored-by:/ && (/[Cc]ursor/ || /@cursor\./) { next }
    { print }
  ' "$COMMIT_MSG_FILE" >"$TMP" || exit 1
  mv "$TMP" "$COMMIT_MSG_FILE"
fi
