    __MODEL_CLASS_LIXEIRA__

    public function noDataLabel(): View
    {
        $podeCriar = auth('admin')->user()?->can('create', __MODULO_STUDLY__::class) ?? false;

        return view('admin.partials.powergrid-empty', [
            'titulo' => 'Nenhum registro encontrado',
            'descricao' => 'Cadastre o primeiro registro para começar.',
            'ctaUrl' => $podeCriar ? route('admin.__MODULO_ROTA_NOME__.create') : null,
