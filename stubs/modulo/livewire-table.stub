                ->showToggleColumns()
                ->includeViewOnTop('livewire.admin.partials.lixeira-toolbar'),
            PowerGrid::footer()
                ->showPerPage()
                ->showRecordCount(),
            PowerGrid::exportable('__MODULO_SNAKE_PLURAL__')
                ->striped()
                ->type(Exportable::TYPE_XLS, Exportable::TYPE_CSV),
