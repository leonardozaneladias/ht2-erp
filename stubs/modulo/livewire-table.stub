    public string $tableName = '__MODULO_ROTA_NOME__-table';

    __PERMISSAO_LISTAGEM__

    /**
     * @return array<int, mixed>
     */
    public function setUp(): array
    {
        return [
            PowerGrid::header()
                ->showSearchInput()
                ->showToggleColumns()
                ->includeViewOnTop('livewire.admin.__MODULO_SNAKE_PLURAL__._export-pdf'),
            PowerGrid::footer()
                ->showPerPage()
