<?php

declare(strict_types=1);

namespace __NS_ACTIONS__;

use __NS_DTOS__\__MODULO_STUDLY__DTO;
use __NS_MODELS__\__MODULO_STUDLY__;
use Illuminate\Support\Facades\DB;

class Update__MODULO_STUDLY__Action
{
    public function execute(__MODULO_STUDLY__ $registro, __MODULO_STUDLY__DTO $dto): __MODULO_STUDLY__
    {
        return DB::transaction(function () use ($registro, $dto): __MODULO_STUDLY__ {
            // Auditoria automática (updated com diff) via trait Auditavel.
            $registro->update($dto->paraModel());

